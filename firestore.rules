rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMessMember(messId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/messes/$(messId)) &&
        request.auth.uid in get(/databases/$(database)/documents/messes/$(messId)).data.memberUids
      );
    }

    function isMessManager(messId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/messes/$(messId)) &&
        (
          request.auth.uid == get(/databases/$(database)/documents/messes/$(messId)).data.managerUid ||
          (('adminUids' in get(/databases/$(database)/documents/messes/$(messId)).data) &&
           request.auth.uid in get(/databases/$(database)/documents/messes/$(messId)).data.adminUids)
        )
      );
    }

    function isValidUser(data) {
      return (!('displayName' in data) || data.displayName is string) &&
        (!('email' in data) || data.email is string) &&
        (!('currentMessId' in data) || data.currentMessId is string) &&
        (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMess(data) {
      return data.keys().hasAll(['name', 'managerUid', 'memberUids', 'activeMonth']) &&
        data.name is string && data.name.size() > 0 &&
        data.managerUid is string && data.managerUid.size() > 0 &&
        data.memberUids is list && data.memberUids.size() > 0 &&
        data.activeMonth is string &&
        (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMember(data) {
      return data.keys().hasAll(['userId', 'displayName', 'role', 'isActive']) &&
        data.userId is string && data.userId.size() > 0 &&
        data.displayName is string && data.displayName.size() > 0 &&
        data.role in ['MANAGER', 'MEMBER'] &&
        data.isActive is bool &&
        (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    function isValidDailyMeal(data) {
      return data.keys().hasAll(['date']) &&
        data.date is string && data.date.size() > 0 &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidBazaarExpense(data) {
      return data.keys().hasAll(['buyerMemberId', 'buyerName', 'amount', 'itemsDescription', 'category', 'date']) &&
        data.buyerMemberId is string &&
        data.buyerName is string &&
        data.amount is number && data.amount >= 0 &&
        data.itemsDescription is string &&
        data.category is string &&
        data.date is string &&
        (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    function isValidDeposit(data) {
      return data.keys().hasAll(['memberId', 'memberName', 'amount', 'date', 'paymentMethod']) &&
        data.memberId is string &&
        data.memberName is string &&
        data.amount is number && data.amount >= 0 &&
        data.date is string &&
        data.paymentMethod is string &&
        (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    function isValidUtilityBill(data) {
      return data.keys().hasAll(['title', 'amount', 'month']) &&
        data.title is string && data.title.size() > 0 &&
        data.amount is number && data.amount >= 0 &&
        data.month is string &&
        (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    // User profile matching uid
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isUser(userId) && isValidUser(request.resource.data);
      allow delete: if isUser(userId);
    }

    // Mess root collection
    match /messes/{messId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.managerUid == request.auth.uid &&
        request.auth.uid in request.resource.data.memberUids;
      allow update: if isMessManager(messId) || (
        request.auth.uid in request.resource.data.memberUids // allow joining
      );
      allow delete: if isMessManager(messId);

      // Members subcollection
      match /members/{memberId} {
        allow read: if isMessMember(messId);
        allow create: if isSignedIn();
        allow update: if isMessManager(messId) || (isSignedIn() && request.auth.uid == resource.data.userId);
        allow delete: if isMessManager(messId);
      }

      // Daily Meals subcollection (Bookings, Attendance, Service Status, Final Orders)
      match /daily_meals/{dateId} {
        allow read: if isMessMember(messId);
        allow create: if isMessMember(messId);
        allow delete: if isMessManager(messId);
        // Updates:
        // - Managers can update all fields (attendance, cancellations, override bookings, final orders)
        // - Regular members can only update bookings without modifying attendances, service status, or final orders
        allow update: if isMessManager(messId) || (
          isMessMember(messId) &&
          (!('attendances' in request.resource.data) || request.resource.data.attendances == resource.data.attendances) &&
          (!('lunchServiceStatus' in request.resource.data) || request.resource.data.lunchServiceStatus == resource.data.lunchServiceStatus) &&
          (!('nightServiceStatus' in request.resource.data) || request.resource.data.nightServiceStatus == resource.data.nightServiceStatus) &&
          (!('lunchFinalOrder' in request.resource.data) || request.resource.data.lunchFinalOrder == resource.data.lunchFinalOrder) &&
          (!('nightFinalOrder' in request.resource.data) || request.resource.data.nightFinalOrder == resource.data.nightFinalOrder)
        );
      }

      // Bazaar expenses subcollection
      match /bazaar_expenses/{expenseId} {
        allow read: if isMessMember(messId);
        allow create: if isMessMember(messId) && isValidBazaarExpense(request.resource.data);
        allow update, delete: if isMessManager(messId) || (isMessMember(messId) && resource.data.buyerMemberId == request.auth.uid);
      }

      // Deposits subcollection - ONLY MANAGERS CAN ADD, EDIT OR DELETE DEPOSITS!
      match /deposits/{depositId} {
        allow read: if isMessMember(messId);
        allow create, update, delete: if isMessManager(messId) && isValidDeposit(request.resource.data);
      }

      // Utility bills subcollection - ONLY MANAGERS CAN ADD, EDIT OR DELETE UTILITIES!
      match /utility_bills/{billId} {
        allow read: if isMessMember(messId);
        allow create, update, delete: if isMessManager(messId) && isValidUtilityBill(request.resource.data);
      }

      // Audit logs - Immutable audit trail of financial changes and overrides
      match /audit_logs/{logId} {
        allow read: if isMessMember(messId);
        allow create: if isMessMember(messId);
        allow update, delete: if false; // Immutable!
      }
    }
  }
}
